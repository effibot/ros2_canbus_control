# Request
uint8 node_id                           # CANopen node ID (1-127)

# Lookup by name (from object dictionary)
string object_name                      # e.g., "target_position", "controlword"

# OR lookup by direct index (if object_name is empty)
uint16 index                            # Object dictionary index (e.g., 0x607A)
uint8 subindex                          # Object dictionary subindex (default: 0)

# Value to write (use appropriate field based on type)
uint8 value_u8
uint16 value_u16
uint32 value_u32
int8 value_i8
int16 value_i16
int32 value_i32
uint8[] value_bytes                     # For raw data or strings

# Metadata (optional, for validation)
string value_type                       # Expected type: "uint16", "int32", etc.

---
# Response
bool success                            # True if write successful
string message                          # Error message if failed, or success confirmation

# Verification (read-back value if requested)
bool verified                           # True if write was verified by reading back
uint8[] read_back_data                  # Data read back for verification
