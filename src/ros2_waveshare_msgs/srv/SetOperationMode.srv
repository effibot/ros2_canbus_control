# Request
uint8 node_id                           # CANopen node ID (1-127)
int8 operation_mode                     # Desired operation mode

# Operation mode constants (match MotorCommand)
int8 NO_MODE = 0
int8 PROFILE_POSITION = 1
int8 PROFILE_VELOCITY = 3
int8 PROFILE_TORQUE = 4
int8 HOMING = 6
int8 INTERPOLATED_POSITION = 7
int8 CYCLIC_SYNC_POSITION = 8
int8 CYCLIC_SYNC_VELOCITY = 9
int8 CYCLIC_SYNC_TORQUE = 10

---
# Response
bool success                            # True if mode set successfully
string message                          # Error message if failed

int8 previous_mode                      # Mode before change
int8 current_mode                       # Actual mode after setting (verified)
