{
	"name": "ROS2 CAN Bus Control - Intel GPU",
	"dockerComposeFile": [
		"compose.yaml"
	],
	"service": "ros2_jazzy",
	"workspaceFolder": "/home/ubuntu/ros_ws",
	"shutdownAction": "stopCompose",
	"hostRequirements": {
		"gpu": "optional"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"njpwerner.autodocstring",
				"ms-python.autopep8",
				"mads-hartmann.bash-ide-vscode",
				"edwinhuish.better-comments-next",
				"jeff-hykin.better-dockerfile-syntax",
				"ms-vscode.cpptools",
				"matepek.vscode-catch2-test-adapter",
				"ms-vscode.cmake-tools",
				"ms-azuretools.vscode-containers",
				"Guyutongxue.cpp-reference",
				"ms-vscode-remote.remote-containers",
				"ms-azuretools.vscode-docker",
				"docker.docker",
				"cschlosser.doxdocgen",
				"hediet.vscode-drawio",
				"nopeslide.vscode-drawio-plugin-mermaid",
				"usernamehw.errorlens",
				"ms-python.flake8",
				"mhutchie.git-graph",
				"shyykoserhiy.git-autoconfig",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"BetaVersion.vscode-github-desktop",
				"GitHub.vscode-pull-request-github",
				"codezombiech.gitignore",
				"VisualStudioExptTeam.vscodeintellicode",
				"VisualStudioExptTeam.intellicode-api-usage-examples",
				"ms-python.isort",
				"AykutSarac.jsoncrack-vscode",
				"yzhang.markdown-all-in-one",
				"bierner.markdown-checkbox",
				"bierner.markdown-footnotes",
				"bierner.markdown-preview-github-styles",
				"bierner.markdown-mermaid",
				"bierner.markdown-yaml-preamble",
				"MermaidChart.vscode-mermaid-chart",
				"IBM.output-colorizer",
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				"rodolphebarbanneau.python-docstring-highlighter",
				"ms-python.vscode-python-envs",
				"KevinRose.vsc-python-indent",
				"ms-vscode-remote.remote-ssh",
				"ms-vscode-remote.remote-ssh-edit",
				"ms-vscode.remote-explorer",
				"ms-vscode.remote-repositories",
				"Ranch-Hand-Robotics.rde-ros-2",
				"Ranch-Hand-Robotics.urdf-editor",
				"althack.ament-task-provider",
				"ms-vscode.vscode-serial-monitor",
				"foxundermoon.shell-format",
				"timonwong.shellcheck",
				"Gruntfuggly.todo-tree",
				"zachflower.uncrustify",
				"vscode-icons-team.vscode-icons",
				"redhat.vscode-xml",
				"redhat.vscode-yaml"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/bin/python3",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true,
				"python.linting.flake8Enabled": true,
				"python.formatting.provider": "autopep8",
				"C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
				"C_Cpp.default.compilerPath": "/usr/bin/gcc",
				"C_Cpp.default.cStandard": "gnu17",
				"C_Cpp.default.cppStandard": "c++17",
				"files.associations": {
					"*.repos": "yaml",
					"*.world": "xml",
					"*.xacro": "xml",
					"*.urdf": "xml",
					"*.sdf": "xml"
				},
				"terminal.integrated.shell.linux": "/bin/zsh",
				"ros.distro": "jazzy"
			}
		}
	},
	// Mounts for Intel GPU and graphics
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
		"source=${localWorkspaceFolder}/config/aliases.sh,target=/home/ubuntu/.bash_aliases,type=bind",
		"source=${localWorkspaceFolder}/config/nanorc,target=/home/ubuntu/.nanorc,type=bind",
		"source=${localWorkspaceFolder}/config/vimrc,target=/home/ubuntu/.vimrc,type=bind"
	],
	// Set the default user
	"remoteUser": "ubuntu"
}