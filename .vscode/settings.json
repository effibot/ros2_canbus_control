        "mutex": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "ranges": "cpp",
        "scoped_allocator": "cpp",
        "semaphore": "cpp",
        "shared_mutex": "cpp",
        "span": "cpp",
        "spanstream": "cpp",
        "sstream": "cpp",
        "stacktrace": "cpp",
        "stdexcept": "cpp",
        "stdfloat": "cpp",
        "stop_token": "cpp",
        "streambuf": "cpp",
        "syncstream": "cpp",
        "typeindex": "cpp",
        "typeinfo": "cpp",
        "valarray": "cpp",
        "variant": "cpp",
        "*.txx": "cpp"
    },
    // Python settings for ROS2 development
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "autopep8",
    // Terminal settings
    "terminal.integrated.shell.linux": "/bin/zsh",
    "terminal.integrated.env.linux": {
        "ROS_DOMAIN_ID": "42"
    },
    // Git settings
    "git.autofetch": true,
    "git.confirmSync": false,
    // Editor settings
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    // Search settings
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/.git": true,
        "**/node_modules": true
    },
    // File watcher settings
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true
    },
    "ROS2.distro": "jazzy",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "/opt/ros/${env:ROS_DISTRO}/lib/ros_site_packages/",
        "${workspaceFolder}/src"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages",
        "${workspaceFolder}/src"
    ],
    "python.analysis.autoImportCompletions": true,
    "python.envFile": "${workspaceFolder}/.env",
    "autopep8.args": [
        "--max-line-length=100"
    ],
    "cmake.ignoreCMakeListsMissing": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "C_Cpp.formatting": "disabled",
    "uncrustify.configPath.linux": "${workspaceFolder}/.vscode/uncrustify.cfg",
    "[cpp]": {
        "editor.defaultFormatter": "zachflower.uncrustify"
    },
    "cSpell.allowCompoundWords": true,
    "cSpell.words": [
        "ament",
        "amentindex",
        "amentlint",
        "amenttool",
        "amentuncrustify",
        "autopep",
        "canopen",
        "canusb",
        "ccache",
        "clangd",
        "cmake",
        "cobid",
        "colcon",
        "colconbuild",
        "colcontest",
        "cppcheck",
        "cpptools",
        "cuda",
        "Cudnn",
        "DALREADY",
        "DCMAKE",
        "direnv",
        "dirmngr",
        "doxygen",
        "eamodio",
        "Efficace",
        "EMCY",
        "fdfind",
        "ffmt",
        "fgrep",
        "gazebo",
        "gazebosim",
        "gdbserver",
        "GNUCXX",
        "ignition",
        "isort",
        "kbps",
        "libasio",
        "libboost",
        "libtbb",
        "mechatroner",
        "mgesbert",
        "MITSHM",
        "mtsmfm",
        "njpwerner",
        "nlohmann",
        "osrf",
        "pygments",
        "pylint",
        "pytest",
        "rclcpp",
        "ROS_DISTRO",
        "rosdep",
        "rosdistro",
        "rosidl",
        "rosinstall",
        "roslaunch",
        "RPDO",
        "srvs",
        "TCGETS",
        "TCSETS",
        "TPDO",
        "uncrustify",
        "urdf",
        "vimrc",
        "Waveshare",
        "WBAD",
        "Werror",
        "Wextra",
        "Wpedantic",
        "xacro",
        "XAUTHORITY",
        "Xorg"
    ],
    "cSpell.ignorePaths": [
        "**/.git/objects/**",
        ".vscode",
        ".vscode-insiders",
        ".devcontainer/**/devcontainer.json",
        ".devcontainer/**/compose.yaml",
        "**/build/**",
        "**/install/**",
        "**/log/**"
    ],
    "ament-task-provider.envSetup": "source /opt/ros/${env:ROS_DISTRO}/setup.bash",
    "cmake.options.statusBarVisibility": "visible",
}